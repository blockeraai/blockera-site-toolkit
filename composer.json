{
    "name": "blockeraai/site-toolkit-plugin",
    "version": "1.0.0",
    "description": "A site toolkit plugin for Blockera AI.",
    "type": "library",
    "repositories": [
        {
            "type": "path",
            "url": "packages/utils"
        },
        {
            "type": "path",
            "url": "packages/bootstrap"
        },
        {
            "type": "path",
            "url": "packages/wordpress"
        },
		{
			"type": "path",
			"url": "packages/site-toolkit"
		}
    ],
    "require": {
        "blockera/bootstrap": "*",
        "blockera/utils": "*",
        "blockera/wordpress": "*",
        "illuminate/container": "8.x-dev",
        "league/oauth2-server": "^9.0",
        "guzzlehttp/psr7": "^2.7",
        "vlucas/phpdotenv": "^5.6",
		"blockera/site-toolkit": "*"
    },
    "authors": [
        {
            "name": "Blockera AI"
        }
    ],
    "require-dev": {
        "symfony/var-dumper": "^7.1",
        "squizlabs/php_codesniffer": "^3.7",
        "filp/whoops": "^2.16"
    },
    "scripts": {
        "cs-check": "phpcs --standard=phpcs.xml",
        "cs-fix": "phpcbf --standard=phpcs.xml"
    }
}
