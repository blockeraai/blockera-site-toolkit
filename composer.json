{
	"name": "blockeraai/site-toolkit-plugin",
	"version": "1.0.0",
	"description": "A site toolkit plugin for Blockera AI.",
	"type": "library",
	"repositories": [
		{
			"type": "path",
			"url": "packages/global-packages/packages/*",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"php": ">=7.4",
		"blockera/bootstrap": "*",
		"blockera/products": "*",
		"blockera/site-toolkit": "*",
		"blockera/utils": "*",
		"blockera/wordpress": "*",
		"illuminate/container": "8.x-dev",
		"league/oauth2-server": "^7.4",
		"guzzlehttp/psr7": "^2.7",
		"vlucas/phpdotenv": "^5.6"
	},
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"cweagans/composer-patches": true
		}
	},
	"authors": [
		{
			"name": "Blockera AI"
		}
	],
	"require-dev": {
		"blockera/dev-phpunit": "*",
		"symfony/dom-crawler": "5.4.x-dev",
		"symfony/css-selector": "5.4.x-dev",
		"symfony/deprecation-contracts": "2.5.x-dev",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.5.21",
		"spatie/phpunit-snapshot-assertions": "v4.x-dev",
		"squizlabs/php_codesniffer": "^3.7.2",
		"wp-cli/wp-cli-bundle": "^2.4",
		"wp-coding-standards/wpcs": "^3.4.1",
		"wp-phpunit/wp-phpunit": "dev-master",
		"filp/whoops": "^2.15",
		"yoast/phpunit-polyfills": "^2.0@dev",
		"symfony/var-dumper": "5.4.x-dev",
		"10up/wp_mock": "dev-trunk",
		"brain/monkey": "^2.0@dev",
		"mockery/mockery": "1.7.x-dev"
	},
	"scripts": {
		"test": "@php ./vendor/bin/phpunit",
		"lint": "./bin/phpcs.sh --standard=phpcs.xml",
		"cs-fix": "phpcbf --standard=phpcs.xml",
		"format": "phpcbf --standard=phpcs.xml --report-summary --report-source",
		"test:coverage": "@php ./vendor/bin/phpunit --coverage-html php-coverage",
		"phpcs": "./bin/phpcs.sh",
		"phpcbf": "phpcbf"
	},
	"autoload-dev": {
		"psr-4": {
			"Blockera\\Tests\\": "tests/phpunit/main/",
			"Blockera\\Products\\Tests\\": "packages/global-packages/packages/products/php/tests/",
			"Blockera\\SharedAutoload\\Tests\\": "packages/global-packages/packages/autoloader-coordinator/php/tests/"
		},
		"files": [
			"tests/phpunit/main/helpers.php"
		]
	},
	"optimize-autoloader": "true",
	"apcu-autoloader": true,
	"classmap-authoritative": true
}
