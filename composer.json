{
    "name": "blockeraai/site-toolkit",
    "version": "1.0.0",
    "description": "A site toolkit plugin for Blockera AI.",
    "type": "library",
    "repositories": [
        {
            "type": "path",
            "url": "packages/utils"
        },
        {
            "type": "path",
            "url": "packages/bootstrap"
        },
        {
            "type": "path",
            "url": "packages/wordpress"
        }
    ],
    "require": {
        "blockera/bootstrap": "*",
        "blockera/utils": "*",
        "blockera/wordpress": "*",
        "illuminate/container": "8.x-dev",
        "league/oauth2-server": "^9.0",
        "guzzlehttp/psr7": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "BlockeraAI\\SiteToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlockeraAI\\SiteToolkit\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Blockera AI"
        }
    ],
    "require-dev": {
        "symfony/var-dumper": "^7.1",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "cs-check": "phpcs --standard=phpcs.xml",
        "cs-fix": "phpcbf --standard=phpcs.xml"
    }
}