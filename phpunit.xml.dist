<!--
	Site-toolkit-specific PHPUnit config (__BLOCKERA_DIR__ / suites).
	Mirrors blockera plugin suite layout (units + snapshots); keep product-local paths.
	Do not replace with dev-tools/php/phpunit.plugin.xml.dist (core plugin suites).
	@see https://github.com/wp-phpunit/docs
-->
<phpunit
        bootstrap="./packages/global-packages/packages/dev-phpunit/php/bootstrap.php"
        backupGlobals="false"
        colors="true"
        convertErrorsToExceptions="true"
        convertNoticesToExceptions="true"
        convertWarningsToExceptions="true"
        verbose="true"
        failOnEmptyTestSuite="false"
>
    <coverage>
        <report>
            <html outputDirectory="php-coverage" />
        </report>
    </coverage>

    <testsuites>
        <testsuite name="units">
            <directory suffix=".php">./packages/global-packages/packages/dev-phpunit/php/</directory>
            <directory suffix=".php">./packages/site-toolkit/php/tests/</directory>
            <directory suffix=".php">./packages/global-packages/packages/products/php/tests/</directory>
            <exclude>./node_modules/</exclude>
            <exclude>./dist/</exclude>
            <!-- Base test case is Composer-autoloaded; including it again via symlink path fatals. -->
            <exclude>./packages/global-packages/packages/products/php/tests/TestCase.php</exclude>
        </testsuite>
        <testsuite name="snapshots">
            <directory suffix=".php">./packages/global-packages/packages/dev-phpunit/php/</directory>
            <directory suffix=".php">./tests/phpunit/main/</directory>
            <exclude>./node_modules/</exclude>
            <exclude>./dist/</exclude>
        </testsuite>
    </testsuites>

    <php>
        <env name="VERSION" value="1.0-beta" />
        <const name="PHPUNIT_PLUGIN_TEST" value="true"/>
        <env name="__BLOCKERA_DIR__" value="blockera-site-toolkit" />
        <env name="WP_PHPUNIT__TESTS_CONFIG" value="./packages/global-packages/packages/dev-phpunit/php/config.php" />
        <env name="WP_TESTS_CONFIG_FILE_PATH" value="./packages/global-packages/packages/dev-phpunit/php/config.php" />
    </php>

</phpunit>
