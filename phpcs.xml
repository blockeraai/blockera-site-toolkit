<?xml version="1.0"?>
<!-- Edit packages/global-packages/packages/dev-tools/root-configs/phpcs.blockera-site-toolkit.xml -->
<!-- project:bootstrap copies this to the host repo root for the blockera-site-toolkit project and fills the project id. -->
<ruleset name="WordPress Coding Standards for blockera-site-toolkit">
    <description>Consumer ruleset: shared Blockera PHPCS + blockera-site-toolkit text_domain and scan roots.</description>

    <rule ref="./packages/global-packages/packages/dev-tools/php/phpcs.xml"/>

    <config name="text_domain" value="blockera-site-toolkit,blockera,default"/>
    <file>./packages</file>

    <exclude-pattern>*/packages/[^/]*-pro/</exclude-pattern>
    <exclude-pattern>*/packages/[^/]*-pro-[^/]+/</exclude-pattern>
    <exclude-pattern>*/packages/[^/]*-one/</exclude-pattern>
    <exclude-pattern>*/packages/[^/]*-one-[^/]+/</exclude-pattern>

    <arg name="cache" value=".cache/phpcs.json"/>
</ruleset>
