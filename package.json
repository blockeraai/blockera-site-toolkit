	"lint-staged": {
		"*.{js,ts,tsx}": [
			"wp-scripts format",
			"npm run lint:js"
		],
		"!(package-lock).json": [
			"wp-scripts format"
		],
		"*.scss": [
			"npm run lint:css"
		],
		"*.php": [
			"./vendor/bin/phpcs --standard=phpcs.xml"
		]
	},
	"private": true,
	"engines": {
		"node": ">=20.19.0",
		"npm": ">=10.0.0"
	},
	"overrides": {
		"stylelint": "^16.8.2",
		"@wordpress/stylelint-config": "^23.29.0"
	},
	"config": {
		"IS_GUTENBERG_PLUGIN": true,
		"ALLOW_EXPERIMENT_REREGISTRATION": true
	}
}
