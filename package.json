{
	"name": "blockera-site-toolkit",
	"version": "1.0.0",
	"description": "The repository is toolkit for Blockeraai web apps.",
	"scripts": {
		"build": "wp-scripts build --progress --mode production",
		"build:php": "./vendor/bin/php-scoper add-prefix --output-dir=build --force && ./bin/psr-4-architecture.sh && ./bin/generate-composer.json.sh",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js \"packages/site-toolkit\"",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "wp-scripts lint-style \"packages/site-toolkit/**/*.scss\"",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:php": "composer run lint",
		"update:changelogs": "node ./bin/plugin/cli.js update-packages-changelog",
		"other:changelog": "node ./bin/plugin/cli.js changelog",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --progress --mode development",
		"start:debug": "DEBUG_MODE=on wp-scripts start --progress",
		"clean": "rm -rf build dist/* node_modules vendor wordpress",
		"prepare": "husky install",
		"flow": "npx flow status",
		"setup": "npm install && npm run build",
		"test:e2e": "NODE_OPTIONS=--max_old_space_size=4096 npx cypress run --config video=false --browser chrome",
		"test:ct": "NODE_OPTIONS=--max_old_space_size=4096 npx cypress run --component",
		"test:ct:debug": "npx cypress open --component",
		"test:e2e:debug": "npx cypress open --e2e",
		"test:e2e:headed": "npm run test:e2e --headed",
		"test:e2e:record": "npx cypress run --browser chrome",
		"test:js": "wp-scripts test-unit-js --config ./jest.config.js --passWithNoTests",
		"test:js:watch": "wp-scripts test-unit-js --config ./jest.config.js --watch --passWithNoTests",
		"test:js:coverage": "wp-scripts test-unit-js --config ./jest.config.js --coverage --passWithNoTests",
		"test:js:update": "npm run test:js -u",
		"test:generate-output": "jest --json --outputFile=.jest-test-results.json",
		"test:generate-output:dev": "jest --json --outputFile=.jest-test-results.json -- --watch",
		"test:unit:php:setup": "npm run env:start",
		"test:unit:php:base": "wp-env run --env-cwd='wp-content/plugins/blockera-site-toolkit' tests-wordpress vendor/bin/phpunit -c phpunit.xml.dist --verbose",
		"test:unit:php": "npm-run-all test:unit:php:setup test:unit:php:base",
		"test:unit:php:composer": "composer run-script test",
		"version": "grunt version && grunt update-pot",
		"icons:indexing": "node packages/global-packages/packages/dev-tools/bin/create-icon-search-index.js",
		"env": "wp-env",
		"env:stop": "npm run env stop",
		"env:start": "node packages/global-packages/packages/dev-tools/github/scripts/setup-wp-env.js && wp-env start",
		"env:reset": "npm run env:start --update --xdebug",
		"env:tests-cli:bash": "npm run env run tests-cli bash",
		"packages:update": "wp-scripts packages-update",
		"plugin:activate": "wp-env run tests-cli wp plugin activate blockera-site-toolkit",
		"plugin:deactivate": "wp-env run tests-cli wp plugin deactivate blockera-site-toolkit",
		"submodule:bump": "bash packages/global-packages/packages/dev-tools/github/scripts/bump-global-packages-submodule.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/blockeraai/blockera-site-toolkit.git"
	},
	"author": "blockera.ai",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/blockeraai/blockera-site-toolkit/issues"
	},
	"homepage": "https://github.com/blockeraai/blockera-site-toolkit#readme",
	"dependencies": {
		"@blockera/blocks-core": "file:packages/global-packages/packages/blocks-core",
		"@blockera/bootstrap": "file:./packages/global-packages/packages/bootstrap",
		"@blockera/classnames": "file:./packages/global-packages/packages/classnames",
		"@blockera/controls": "file:./packages/global-packages/packages/controls",
		"@blockera/data": "file:./packages/global-packages/packages/data",
